import ygmd.kmpquiz.domain.model.quiz.QuizConfigDetails;

CREATE TABLE quiz_configuration_entity (
    id TEXT PRIMARY KEY,
    quiz_id TEXT NOT NULL UNIQUE,
    config_details TEXT AS QuizConfigDetails,
    FOREIGN KEY (quiz_id) REFERENCES quiz_entity(id) ON DELETE CASCADE
);

insertConfig:
INSERT OR REPLACE INTO quiz_configuration_entity(id, quiz_id, config_details) VALUES (?, ?, ?);

getConfigForQuiz:
SELECT config_details FROM quiz_configuration_entity
WHERE quiz_id = ?;