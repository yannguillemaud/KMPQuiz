import ygmd.kmpquiz.domain.model.qanda.Answers;
import ygmd.kmpquiz.domain.model.qanda.QuestionContent;

CREATE TABLE qanda_entity (
    id TEXT PRIMARY KEY,
    question TEXT AS QuestionContent NOT NULL,
    answers TEXT AS Answers NOT NULL,
    category_id TEXT NOT NULL,
    context_key TEXT NOT NULL UNIQUE,
    FOREIGN KEY(category_id) REFERENCES category_entity(id) ON DELETE CASCADE
);

selectAll:
SELECT * FROM qanda_entity;

getById:
SELECT * FROM qanda_entity q
WHERE q.id = ?;

getByCategory:
SELECT * FROM qanda_entity q
WHERE q.category_id = ?;

getByContextKey:
SELECT * FROM qanda_entity q
WHERE q.context_key = ?;

saveQanda:
INSERT INTO qanda_entity(id, question, answers, category_id, context_key)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
question = excluded.question,
answers = excluded.answers,
category_id = excluded.category_id,
context_key = excluded.context_key;

deleteAll:
DELETE FROM qanda_entity;

deleteById:
DELETE FROM qanda_entity
WHERE id = ?;

deleteByCategoryId:
DELETE FROM qanda_entity
WHERE category_id = ?;