CREATE TABLE category_entity (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL UNIQUE
);

selectAllCategories:
SELECT * FROM category_entity;

selectAllCategoriesWithCount:
SELECT
    c.*,
    (SELECT COUNT(*) FROM qanda_entity q WHERE c.id = q.category_id) AS questionCount
FROM category_entity c;

getCategoryById:
SELECT * FROM category_entity WHERE id = ?;

getCategoryByName:
SELECT * FROM category_entity WHERE name = ?;

insertCategory:
INSERT OR REPLACE INTO category_entity
VALUES ?;

deleteById:
DELETE FROM category_entity
WHERE id = ?;