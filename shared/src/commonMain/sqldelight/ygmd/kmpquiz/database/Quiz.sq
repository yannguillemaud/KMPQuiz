import ygmd.kmpquiz.core.domain.quiz.config.QuizQuestionsConfiguration;

CREATE TABLE IF NOT EXISTS quiz_entity (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    questions_config TEXT AS QuizQuestionsConfiguration NOT NULL
);

selectAll:
SELECT * FROM quiz_entity;

getById:
SELECT * FROM quiz_entity WHERE id=?;

save:
INSERT INTO quiz_entity (
    id, title, questions_config
) VALUES (?, ?, ?) ON CONFLICT(id) DO UPDATE SET
    title = excluded.title,
    questions_config = excluded.questions_config;

deleteById:
DELETE FROM quiz_entity
WHERE id = ?;